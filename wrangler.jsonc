{
  "name": "defi-watch-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "DEFI_WATCH_KV",
      "id": "4fd537fdac5443c4afb9348a903ac592"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "RPC_URL": "https://ethereum.publicnode.com"
  }
}
